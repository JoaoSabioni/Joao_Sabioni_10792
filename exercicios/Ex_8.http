
POST http://localhost:2525/imposters/4545/stubs
Content-Type: application/json

{
  "stub": {
    "predicates": [
      {
        "and": [
          { "equals": { "method": "POST", "path": "/api/temperature" } },
          { "not": { "contains": { "body": "value" } } }
        ]
      }
    ],
    "responses": [
      {
        "is": {
          "statusCode": 400,
          "headers": { "Content-Type": "application/json" },
          "body": { 
            "error": "missing_field", 
            "message": "O campo 'value' é obrigatório para registar a temperatura." 
          }
        }
      }
    ]
  }
}

